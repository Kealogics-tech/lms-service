{
    "name": "spondonit/service",
    "description": "Basic Service Provider for Spondonit application",
    "type": "library",
    "license": "MIT",
    "authors": [{
        "name": "spondonit",
        "email": "support@spondonit.com"
    }],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
  "require-dev": {
    "laravel/framework": "^10.0|^11.0|^12.0"
  },
    "autoload": {
        "psr-4": {
            "SpondonIt\\Service\\": "src/"
        },
        "files": ["helpers/helper.php"]
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "SpondonIt\\Service\\SpondonItServiceProvider"
            ]
        }
    }
}
